{
    "name": "@chrisgeo/opencode-antigravity-auth",
    "version": "1.7.0",
    "description": "Google Antigravity IDE OAuth auth plugin for Opencode - access Gemini 3 Pro and Claude 4.6 using Google credentials",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "author": "noefabris",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/chrisgeo/opencode-antigravity-auth.git"
    },
    "homepage": "https://github.com/chrisgeo/opencode-antigravity-auth#readme",
    "bugs": {
        "url": "https://github.com/chrisgeo/opencode-antigravity-auth/issues"
    },
    "keywords": [
        "opencode",
        "google",
        "antigravity",
        "gemini",
        "oauth",
        "plugin",
        "auth",
        "claude"
    ],
    "engines": {
        "node": ">=22.22.2"
    },
    "files": [
        "dist/",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/fix-esm-imports.mjs",
        "build:schema": "npx tsx script/build-schema.ts",
        "check:v2-workflows": "node scripts/check-v2-workflows.mjs",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "prepublishOnly": "npm run build",
        "verify:pack": "node scripts/verify-pack.mjs",
        "test:e2e:models": "npx tsx script/test-models.ts",
        "test:e2e:regression": "npx tsx script/test-regression.ts"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "devDependencies": {
        "@types/node": "^24.13.3",
        "@types/proper-lockfile": "^4.1.4",
        "@vitest/coverage-v8": "^3.2.7",
        "@vitest/ui": "^3.2.7",
        "typescript": "^5.9.3",
        "vitest": "^3.2.7",
        "zod-to-json-schema": "^3.25.2"
    },
    "dependencies": {
        "@ai-sdk/google": "3.0.64",
        "@openauthjs/openauth": "^0.4.3",
        "@opencode-ai/ai": "0.0.0-next-17444",
        "@opencode-ai/plugin": "0.0.0-next-17444",
        "@opencode-ai/schema": "0.0.0-next-17444",
        "@types/json-schema": "7.0.15",
        "proper-lockfile": "^4.1.2",
        "xdg-basedir": "^5.1.0",
        "zod": "^4.4.3"
    }
}
